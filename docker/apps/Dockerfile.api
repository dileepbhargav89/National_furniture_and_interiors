# Multi-stage build for apps/api — docs/06_project_structure.md §7.1, docs/10_devops_architecture.md §4.1.
# Standard shape shared by all four Dockerfiles: deps -> build -> runtime (docs/10 §4.1).
# Build-once-promote-many, git-SHA image tagging (docs/10 §5, docs/13 §1.3-1.4).

FROM node:22-alpine AS base
RUN corepack enable
WORKDIR /repo

# ---- deps: install the full workspace graph (pnpm's strict, non-hoisted install, docs/05 §13) ----
FROM base AS deps
COPY . .
RUN pnpm install --frozen-lockfile

# ---- build: compile @nfi/api and every workspace package it depends on ----
FROM deps AS build
RUN pnpm turbo run build --filter=@nfi/api...

# ---- runtime: minimal, non-root, production-only image ----
FROM node:22-alpine AS runtime
RUN corepack enable && addgroup -S nfi && adduser -S nfi -G nfi
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /repo/apps/api/dist ./dist
COPY --from=build /repo/apps/api/package.json ./package.json
COPY --from=build /repo/node_modules ./node_modules
COPY --from=build /repo/packages ./packages
USER nfi
EXPOSE 4000
CMD ["node", "dist/server.js"]

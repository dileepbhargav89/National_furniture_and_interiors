# Multi-stage build for apps/api — docs/06_project_structure.md §7.1, docs/10_devops_architecture.md §4.1.
# Standard shape shared by all four Dockerfiles: deps -> build -> runtime (docs/10 §4.1).
# Build-once-promote-many, git-SHA image tagging (docs/10 §5, docs/13 §1.3-1.4).

FROM node:22-alpine AS base
RUN corepack enable
WORKDIR /repo

# ---- deps: install the full workspace graph (pnpm's strict, non-hoisted install, docs/05 §13) ----
FROM base AS deps
COPY . .
RUN pnpm install --frozen-lockfile

# ---- build: compile @nfi/api and every workspace package it depends on ----
FROM deps AS build
RUN pnpm turbo run build --filter=@nfi/api...

# ---- runtime: minimal, non-root, production-only image ----
# pnpm's strict, non-hoisted node_modules (docs/05 §13) resolves packages via symlinks into a
# root .pnpm store, relative to each package's own position in the tree — so the runtime image
# preserves the real repo-relative layout (apps/api/node_modules, not a flattened /app) rather
# than copying dist/package.json/node_modules into unrelated flat paths.
FROM node:22-alpine AS runtime
RUN corepack enable && addgroup -S nfi && adduser -S nfi -G nfi
WORKDIR /repo
ENV NODE_ENV=production
COPY --from=build /repo/node_modules ./node_modules
COPY --from=build /repo/apps/api/node_modules ./apps/api/node_modules
COPY --from=build /repo/apps/api/dist ./apps/api/dist
COPY --from=build /repo/apps/api/package.json ./apps/api/package.json
COPY --from=build /repo/packages ./packages
USER nfi
WORKDIR /repo/apps/api
EXPOSE 4000

# Container health = READINESS (docs/10_devops_architecture.md §10.4). Docker/Compose's healthcheck
# is what `depends_on: condition: service_healthy` gates on, i.e. "can this instance serve traffic
# yet" — that is /ready's question, not /health's. On ECS (docs/10 §8.1) the two map to separate
# probes: the ECS container health check to /health (restart on failure) and the ALB target-group
# health check to /ready (drain from rotation without restarting).
HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:4000/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "dist/server.js"]

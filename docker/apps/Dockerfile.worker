# Multi-stage build for the worker process — docs/06_project_structure.md §7.1, §4.5,
# docs/10_devops_architecture.md §4.1. Same codebase as Dockerfile.api (apps/worker/README.md:
# the worker entry point is apps/api/src/worker.ts, not a standalone package — docs/06 §17 open item),
# different entry point (docs/04_architecture_decision.md §10.3).

FROM node:22-alpine AS base
RUN corepack enable
WORKDIR /repo

# ---- deps: install the full workspace graph (pnpm's strict, non-hoisted install, docs/05 §13) ----
FROM base AS deps
COPY . .
RUN pnpm install --frozen-lockfile

# ---- build: compile @nfi/api (worker.ts is part of the same package) and its dependencies ----
FROM deps AS build
RUN pnpm turbo run build --filter=@nfi/api...

# ---- runtime: minimal, non-root, production-only image ----
FROM node:22-alpine AS runtime
RUN corepack enable && addgroup -S nfi && adduser -S nfi -G nfi
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /repo/apps/api/dist ./dist
COPY --from=build /repo/apps/api/package.json ./package.json
COPY --from=build /repo/node_modules ./node_modules
COPY --from=build /repo/packages ./packages
USER nfi
CMD ["node", "dist/worker.js"]

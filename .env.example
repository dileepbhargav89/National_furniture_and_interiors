# National Furniture & Interiors — Environment Variable Reference
# docs/05_repository_strategy.md §11, docs/06_project_structure.md §7.4, docs/09_security_architecture.md §5.1
#
# This file documents every environment variable used anywhere in the repository, WITHOUT values.
# Real values are NEVER committed. Local dev values go in gitignored .env / .env.local files
# (apps/api/.env, apps/storefront/.env.local, apps/admin/.env.local).
# Staging/Production values are injected via the orchestrator's secret store at deploy time — never as files.

# ---------------------------------------------------------------------------
# apps/api — backend secrets (NEVER exposed to a frontend bundle, NEVER NEXT_PUBLIC_-prefixed)
# ---------------------------------------------------------------------------
NODE_ENV=
PORT=
MONGODB_URI=
REDIS_URL=
CORS_ALLOWED_ORIGINS=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=
JWT_REFRESH_TTL=
MFA_TOTP_ISSUER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
EMAIL_PROVIDER_API_KEY=
SMS_WHATSAPP_PROVIDER_API_KEY=
SENTRY_DSN=
LOG_LEVEL=

# ---------------------------------------------------------------------------
# apps/storefront, apps/admin — client-safe values only (safe to expose, NEXT_PUBLIC_ prefixed)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_ANALYTICS_ID=
NEXT_PUBLIC_SENTRY_DSN=

# ---------------------------------------------------------------------------
# apps/worker — shares apps/api's backend secrets above (same process family, docs/06 §4.5)
# ---------------------------------------------------------------------------

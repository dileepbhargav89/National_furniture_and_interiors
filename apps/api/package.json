{
  "name": "@nfi/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "dev:worker": "tsx watch --env-file=.env src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@nfi/shared": "workspace:*",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.21.0",
    "cloudinary": "2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "google-auth-library": "11.0.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^8.7.0",
    "multer": "2.3.0",
    "otplib": "^12.0.1",
    "pino": "^9.5.0",
    "rate-limit-redis": "^4.2.0",
    "razorpay": "2.9.8",
    "sanitize-html": "2.17.7",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@nfi/eslint-config": "workspace:*",
    "@nfi/tsconfig": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "2.2.0",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "0.17.6",
    "@types/sanitize-html": "2.16.1",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.13.0",
    "mongodb-memory-server": "11.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
